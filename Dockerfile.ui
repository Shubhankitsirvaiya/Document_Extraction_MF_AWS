FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
RUN pip install --no-cache-dir \
    "boto3>=1.40,<2" "botocore>=1.40,<2" "pillow>=11,<13" \
    "pydantic>=2.11,<3" "python-dotenv>=1.1,<2" "requests>=2.32,<3" \
    "streamlit>=1.50,<2"
COPY app ./app
COPY config ./config
EXPOSE 8501
CMD ["streamlit", "run", "app/ui/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
